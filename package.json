{
  "name": "cert-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "prisma generate && next build",
    "start": "next start --port 3003",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "inspect:cert": "node scripts/inspect-cert.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "deploy-template": "copy .env.example .env",
    "deploy:pack": "powershell -ExecutionPolicy Bypass -File ./scripts/build-release.ps1",
    "deploy:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-server.ps1"
  },
