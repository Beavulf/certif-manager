    "antd": "^6.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
