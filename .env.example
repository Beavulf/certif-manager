# production — на сервере; development — локальная разработка
NODE_ENV=production

# Порт веб-приложения
PORT=3003

# Сервис AD-авторизации (schedule-ad-blocker / WEB AD Tools)
AUTH_URL=http://localhost:3005/graphql

# Домен e-mail сотрудников в AD
AD_EMAIL_DOMAIN=local.corp

# PostgreSQL (уже установлен на сервере)
DB_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/cert_manager?schema=public

# RustFS (S3-совместимое хранилище, только для сервера приложения)
# localhost — нормально: скачивание идёт через приложение, не напрямую в RustFS
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=rustfsadmin
MINIO_SECRET_KEY=rustfsadmin
MINIO_BUCKET=certificates
MINIO_USE_SSL=false

# false for HTTP without HTTPS
COOKIE_SECURE=false

# false for internal SMTP with self-signed / corporate CA certificate
SMTP_TLS_REJECT_UNAUTHORIZED=false

# Secret for Windows Task Scheduler → POST /api/cron/daily-check
# Generate any long random string. Required for reliable 08:00 runs on Windows.
CRON_SECRET=change-me-to-a-long-random-string
